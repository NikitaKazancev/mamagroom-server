		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "^11.0.16",
		"@nestjs/jwt": "^11.0.0",
		"@nestjs/mapped-types": "^2.1.0",
		"@nestjs/microservices": "^11.0.16",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-express": "^11.0.16",
		"@nestjs/platform-fastify": "^11.0.16",
		"@nestjs/platform-socket.io": "^11.0.16",
		"@nestjs/schedule": "^5.0.1",
		"@nestjs/serve-static": "^5.0.3",
		"@nestjs/swagger": "^11.1.2",
		"@nestjs/websockets": "^11.0.16",
		"@nestlab/google-recaptcha": "^3.10.0",
