{
	"name": "mamagroom-server",
	"version": "0.1.33",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NikitaKazancev/mamagroom-server.git"
	},
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"dev": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 nest start --watch",
		"debug": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 nest start --debug --watch",
		"prod": "node dist/src/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"migrate": "prisma migrate dev --create-only",
		"migrate:apply": "prisma migrate dev",
		"migrate:reset": "prisma migrate reset",
		"db-seed": "tsc prisma/seed.ts && cat prisma/seed.js | node --input-type=\"commonjs\""
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts",
		"schema": "prisma/schema"
	},
	"dependencies": {
		"@nestjs/axios": "^3.0.3",
		"@nestjs/cache-manager": "^2.2.2",
		"@nestjs/common": "^10.0.0",
		"@nestjs/config": "^3.3.0",
		"@nestjs/core": "^10.0.0",
		"@nestjs/jwt": "^10.2.0",
		"@nestjs/mapped-types": "^2.0.5",
		"@nestjs/microservices": "^10.4.15",
		"@nestjs/passport": "^10.0.3",
		"@nestjs/platform-express": "^10.0.0",
		"@nestjs/schedule": "^4.1.2",
		"@nestjs/serve-static": "^4.0.2",
		"@prisma/client": "^5.22.0",
		"@prisma/extension-read-replicas": "^0.4.0",
		"argon2": "^0.40.3",
		"axios": "^1.7.7",
		"cache-manager": "^5.7.6",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"cookie-parser": "^1.4.6",
		"https-proxy-agent": "^7.0.6",
		"kafkajs": "^2.2.4",
		"mamagroom-server": "file:",
		"openai": "^4.73.1",
		"passport": "^0.7.0",
		"passport-github2": "^0.1.12",
		"passport-google-oauth20": "^2.0.0",
		"passport-jwt": "^4.0.1",
		"reflect-metadata": "^0.2.0",
		"rxjs": "^7.8.1",
		"uuid": "^11.0.3"
	},
	"devDependencies": {
		"@nestjs/cli": "^10.0.0",
		"@nestjs/schematics": "^10.0.0",
		"@nestjs/testing": "^10.4.1",
		"@types/cookie-parser": "^1.4.7",
		"@types/express": "^4.17.17",
		"@types/jest": "^29.5.12",
		"@types/multer": "^1.4.11",
		"@types/node": "^20.3.1",
		"@types/passport-github2": "^1.2.9",
		"@types/passport-google-oauth20": "^2.0.16",
		"@types/passport-jwt": "^4.0.1",
		"@types/supertest": "^6.0.0",
		"@typescript-eslint/eslint-plugin": "^7.0.0",
		"@typescript-eslint/parser": "^7.0.0",
		"cross-env": "^7.0.3",
		"eslint": "^8.42.0",
		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin-prettier": "^5.0.0",
		"jest": "^29.7.0",
		"prettier": "^3.0.0",
		"prisma": "^5.22.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.4",
		"ts-loader": "^9.4.3",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.17.0",
		"typescript": "^5.1.3"
	}
}
