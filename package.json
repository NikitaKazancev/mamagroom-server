{
	"name": "mamagroom-server",
	"version": "1.0.4",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NikitaKazancev/mamagroom-server.git"
	},
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"dev": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 nest start --watch",
		"debug": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 nest start --debug --watch",
		"prod": "node dist/src/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "cross-env NODE_ENV=test jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"migrate": "npx prisma migrate dev --create-only",
		"migrate-deploy": "npx prisma migrate deploy",
		"migrate-apply": "npx prisma migrate dev",
		"migrate-reset": "npx prisma migrate reset",
		"db-seed": "tsc prisma/seed.ts && cat prisma/seed.js | node --input-type=\"commonjs\"",
		"safari": "npx playwright wk http://localhost"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts",
		"schema": "prisma/schema"
	},
	"dependencies": {
		"@fastify/cookie": "^11.0.2",
		"@fastify/static": "^8.1.1",
		"@grpc/grpc-js": "^1.13.3",
